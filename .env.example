# Copy this file to .env.local and fill in values as each milestone needs them.
# .env.local is git-ignored. Never commit real values or paste them into chat.

# --- M0: nothing required ---

# --- M2: database ---
# Easiest: Vercel dashboard -> the flatch project -> Storage -> Create Database -> Neon (free).
# Then open the database's ".env.local" tab, copy the snippet and paste it into .env.local.
# Only these two are used. Without DATABASE_URL the app runs on its in-browser mock.
# DATABASE_URL=              # the pooled address; the app uses this
# DATABASE_URL_UNPOOLED=     # the direct address; migrations and seeding prefer it

# --- M3: photo uploads (optional) ---
# Without these three, listers pick from sample photos. With them, they can upload their own.
# Cloudinary (free plan) -> dashboard for the cloud name; Settings -> API Keys for the other two.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- M3: sign-in ---
# Guests need nothing here. Google sign-in appears on the Profile tab once both Google values are set.
# Google Cloud console -> APIs & Services -> Credentials -> Create OAuth client (Web application).
# Authorized redirect URIs: https://<your-site>/api/auth/callback/google
#                           http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The key that signs session cookies. Without it one is worked out from DATABASE_URL, which
# means changing the database signs everyone out. The live site has it set: never change it there.
# BETTER_AUTH_SECRET=        # generate with: openssl rand -base64 32
# Optional. The site's address, if it is not localhost or the Vercel production address.
# BETTER_AUTH_URL=

# --- M4 (optional): realtime chat (Pusher dashboard -> App Keys) ---
# PUSHER_APP_ID=
# PUSHER_SECRET=
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=

# --- M6 (optional): cache, jobs, errors, cron ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# SENTRY_DSN=
# CRON_SECRET=
