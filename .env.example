# Copy this file to .env.local and fill in values as each milestone needs them.
# .env.local is git-ignored. Never commit real values or paste them into chat.

# --- M0: nothing required ---

# --- M2: database ---
# Easiest: Vercel dashboard -> the flatch project -> Storage -> Create Database -> Neon (free).
# Then open the database's ".env.local" tab, copy the snippet and paste it into .env.local.
# Only these two are used. Without DATABASE_URL the app runs on its in-browser mock.
# DATABASE_URL=              # the pooled address; the app uses this
# DATABASE_URL_UNPOOLED=     # the direct address; migrations and seeding prefer it

# --- M3: images, when people upload their own (Cloudinary console -> Settings -> API Keys) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- M3: auth ---
# BETTER_AUTH_SECRET=        # generate with: openssl rand -base64 32
# GOOGLE_CLIENT_ID=          # Google Cloud console -> APIs & Services -> Credentials
# GOOGLE_CLIENT_SECRET=

# --- M4 (optional): realtime chat (Pusher dashboard -> App Keys) ---
# PUSHER_APP_ID=
# PUSHER_SECRET=
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=

# --- M6 (optional): cache, jobs, errors, cron ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# SENTRY_DSN=
# CRON_SECRET=
