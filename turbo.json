{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["DATABASE_URL"],
      "passThroughEnv": [
        "DATABASE_URL_UNPOOLED",
        "BETTER_AUTH_*",
        "GOOGLE_CLIENT_*",
        "CLOUDINARY_*",
        "PG*",
        "POSTGRES_*",
        "NEON_*",
        "VITE_NEON_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {}
  }
}
